# Copia este archivo como .env.local y ajusta lo que haga falta.
#
# En local la base corre embebida (npm run db:up) y estos valores sirven
# tal cual. En un servidor real apuntan a la base de verdad.

# Rol de la aplicación: NO debe ser dueño de las tablas ni superusuario,
# porque entonces Row Level Security deja de aplicársele y se cae el
# aislamiento entre clientes.
DATABASE_URL=postgres://inpol_app:inpol_local@localhost:5434/inpol

# Rol para migraciones y scripts de mantenimiento. Este sí es dueño.
DATABASE_URL_ADMIN=postgres://inpol:inpol_local@localhost:5434/inpol

# Firma de la cookie de sesión. En producción, una cadena larga y propia:
# si cambia, todas las sesiones abiertas se cierran.
SESSION_SECRET=desarrollo_local_cambiar_en_produccion_min_32_chars
